<IfModule mod_rewrite.c>
RewriteEngine On

# 1. التقاط الروابط القياسية (Smarters & Xtream)
RewriteRule ^(live|movie|series)/([^/]+)/([^/]+)/([^/]+)$ index.php?xtream_play=$1&u=$2&p=$3&id=$4 [QSA,L]

# 2. التقاط الروابط المباشرة بدون كلمة live (حسب طلبك الجديد)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/([^/]+)/([^/]+)$ index.php?xtream_play=live&u=$1&p=$2&id=$3 [QSA,L]
</IfModule>
